{
  "version": 3,
  "configurePresets": [
    {
      "name": "wsl-gcc",
      "displayName": "WSL Ubuntu GCC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wsl-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HEXAGONFLOW_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "HEXAGONFLOW_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wsl-gcc",
      "configurePreset": "wsl-gcc"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "wsl-gcc",
      "configurePreset": "wsl-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
